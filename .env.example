# Copy to .env (never committed). Read by scripts/backfill/backfill_ufcstats.py.

SUPABASE_URL=https://tkmlnhmylqnttmnsnief.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Assertion failures and run summaries are posted here.
DISCORD_WEBHOOK_URL=

# Optional. Only needed with --raw-to-r2. Uses the S3-compatible R2 endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ufc-raw

# Source. http:// on purpose: https on the bare host does not connect (2026-09-05).
UFCSTATS_BASE=http://ufcstats.com
UFCSTATS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36
UFCSTATS_MIN_INTERVAL_SEC=1.0

# Local raw-HTML cache. Re-parsing never re-fetches.
HTML_CACHE_DIR=./cache
