.env
.env.*
!.env.example
node_modules/
__pycache__/
*.pyc
scripts/backfill/cache/
scripts/backfill/logs/
workers/*/.wrangler/
workers/*/dist/
*.zip
.DS_Store
Thumbs.db
docs/.proof_seed.json
scripts/images/cache/
supabase/.temp/
supabase/.branches/
.cache/
.worktrees/

# Local operator token for the ufc-news-ingest Worker. Never committed.
.ufc-news-ingest-admin-token

# Wrangler dry-run build output.
.wrangler-dryrun/
.wrangler/
.ufc-newsroom-admin-token

# Bearer tokens for the admin endpoints and the desk preview. These are
# credentials: they belong on the machine that calls the endpoint, never in the
# tree. NOTE: four .ufc-*-admin-token files are ALREADY TRACKED in this
# repository and this rule does not untrack them -- see the report.
*-admin-token
.desk-preview-token
