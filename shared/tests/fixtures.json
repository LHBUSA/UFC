  "resolve": [
    {
      "name": "ufcstats id wins regardless of name",
      "args": [
        "Totally Wrong Name",
        "espn",
        {
          "ufcstats_id": "aaaaaaaaaaaaaaa5"
        }
      ],
      "expect": {
        "status": "matched",
        "fighter_id": "f-zw",
        "method": "ufcstats_id"
      }
    },
    {
      "name": "exact + weight class disambiguates Bruno Silva",
      "args": [
        "Bruno Silva",
        "espn",
        {
          "weight_class": "FLYWEIGHT"
        }
      ],
      "expect": {
        "status": "matched",
        "fighter_id": "f-bs2",
        "method": "exact_normalized"
      }
    },
    {
      "name": "exact + dob disambiguates Bruno Silva",
      "args": [
        "Bruno Silva",
        "espn",
        {
          "dob": "1989-09-26"
        }
      ],
      "expect": {
        "status": "matched",
        "fighter_id": "f-bs1",
        "method": "exact_normalized"
      }
    },
    {
      "name": "exact name alone with duplicates -> review, three candidates",
      "args": [
        "Bruno Silva",
        "espn",
        {}
      ],
      "expect": {
        "status": "review",
        "n_candidates": 3,
        "reason": "ambiguous"
      }
    },
    {
      "name": "exact unique name but no second key -> review (never name alone)",
      "args": [
        "Jose Aldo",
        "espn",
        {}
      ],
      "expect": {
        "status": "review",
        "n_candidates": 1,
        "reason": "no_second_key"
      }
    },
    {
