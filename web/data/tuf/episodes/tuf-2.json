      "defect": "descriptions_swapped",
      "detail": "The listing's titles for episodes 10 (Semi-Final #1 Killer Instinct) and 11 (Semi-Final #2 Bloody Brawl) agree with the season record, but its two descriptions are swapped: item 10 describes Evans vs Jardine and item 11 describes the semi-final draw and the first welterweight finalist. Titles are used; those descriptions are used only for pairings, never for placing a fact in an episode.",
      "retrieved": "2026-09-13"
    },
    {
      "family": "paramount_plus_episode_metadata",
      "episodes": [
        11,
        12
      ],
      "defect": "shared_listing_date",
      "detail": "Episodes 11 and 12 carry the same listing date (2005-10-31). The independent source dates episode 12 on 2005-11-01, so episode 12 has no resolved air date.",
      "retrieved": "2026-09-13"
    },
    {
      "family": "paramount_plus_episode_metadata",
      "episodes": "all",
      "defect": "display_date_offset",
      "detail": "The display date is one day after the listing date for every item (19:00 Pacific rendered as the next UTC day). The listing date is the one compared.",
      "retrieved": "2026-09-13"
    }
  ],
