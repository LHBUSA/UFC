  "source_defects": [
    {
      "family": "paramount_plus_episode_metadata",
      "episodes": [
        11,
        12
      ],
      "defect": "descriptions_swapped",
      "detail": "The listing's titles for episodes 11 (Middleweight Semi-Final #2) and 12 (Light Heavyweight Semi-Finals) agree with every other source, but its two descriptions are swapped: item 11 describes the light heavyweight semi-finals and item 12 the last middleweight final spot. Titles are used; those descriptions are used only for pairings, never for placing a fact in an episode.",
      "retrieved": "2026-09-13"
    },
    {
      "family": "paramount_plus_episode_metadata",
      "episodes": "all",
      "defect": "display_date_offset",
      "detail": "The display date is one day after the listing date for every item (19:00 Pacific rendered as the next UTC day). The listing date is the one compared.",
      "retrieved": "2026-09-13"
    }
  ],
